# 复制为 .env 后填写真实配置（勿将 .env 提交到 Git）

# FLASK
DEBUG=True
FLASK_ENV=development
WTF_CSRF_ENABLED=False

# PostgreSQL
SQLALCHEMY_DATABASE_URI=postgresql://postgres:your_password@127.0.0.1:5432/llmops_project
SQLALCHEMY_POOL_SIZE=30
SQLALCHEMY_POOL_RECYCLE=3600
SQLALCHEMY_ECHO=true

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1

# LangSmith（可选）
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=llmops_project

# 百度千帆（可选）
QIANFAN_API_KEY=
QIANFAN_ACCESS_KEY=
QIANFAN_SECRET_KEY=

# HuggingFace（可选，本地模型需另行下载）
HUGGINGFACEHUB_API_TOKEN=
TRANSFORMERS_OFFLINE=1

# Pinecone（可选）
PINECONE_API_KEY=

# 腾讯向量库（可选）
TC_VECTOR_DB_URL=
TC_VECTOR_DB_USERNAME=
TC_VECTOR_DB_KEY=
TC_VECTOR_DB_DATABASE=
TC_VECTOR_DB_TIMEOUT=30

# Cohere（可选）
COHERE_API_KEY=

# 高德（可选）
GAODE_API_KEY=

# Google Serper（可选）
SERPER_API_KEY=

# 腾讯云 COS
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_SCHEME=https
COS_BUCKET=
COS_DUMAIN=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_USE_SSL=False

# Celery
CELERY_BROKER_DB=1
CELERY_RESULT_BACKEND_DB=1
CELERY_TASK_IGNORE_RESULT=False
CELERY_RESULT_EXPIRES=3600
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=True

# GitHub OAuth（可选）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5000/oauth/authorize/github

# JWT
JWT_SECRET_KEY=change_me_to_a_random_secret

# Weaviate
WEAVIATE_HTTP_HOST=127.0.0.1
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_HOST=127.0.0.1
WEAVIATE_GRPC_PORT=50051
WEAVIATE_API_KEY=
